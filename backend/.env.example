# === Database (MySQL) ===
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=curricula_ai

# Optional: override the constructed URL entirely
# DATABASE_URL=mysql+pymysql://user:pass@host:3306/dbname?charset=utf8mb4

# === AI Provider ===
# Prefers OpenRouter if OPENROUTER_API_KEY is set, otherwise OpenAI.
# Set OPENAI_API_KEY=MOCK_KEY_FOR_DEVELOPMENT to run in offline mock mode.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openai/gpt-4o-mini
