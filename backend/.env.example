# AI Course Generator - Backend Environment Configuration

# OpenAI API Key for AI course content generation
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Database Connection URL (MySQL or SQLite fallback)
# MySQL Example: mysql+pymysql://db_user:db_password@localhost:3306/curricula_db
# SQLite Fallback: sqlite:///./curricula.db
DATABASE_URL=sqlite:///./curricula.db

# Environment mode (development / production)
ENV=production
